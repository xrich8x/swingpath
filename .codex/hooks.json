{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "'e:\\Claude Outputs\\Cowork Tasks\\Swing Vision\\.codex\\hooks\\agent-cap.sh'",
            "timeout": 10,
            "statusMessage": "Checking the project-wide concurrent-agent cap"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'e:\\Claude Outputs\\Cowork Tasks\\Swing Vision\\.codex\\hooks\\agent-cap.sh'",
            "timeout": 10,
            "statusMessage": "Checking for agent slots held from a previous session"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'e:\\Claude Outputs\\Cowork Tasks\\Swing Vision\\.codex\\hooks\\agent-cap.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'e:\\Claude Outputs\\Cowork Tasks\\Swing Vision\\.codex\\hooks\\agent-cap.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'e:\\Claude Outputs\\Cowork Tasks\\Swing Vision\\.codex\\hooks\\agent-cap.sh'",
            "timeout": 10,
            "statusMessage": "Checking for parked agent tasks"
          }
        ]
      }
    ]
  }
}

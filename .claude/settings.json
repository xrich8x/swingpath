{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/scoreboard-guard.sh\"",
            "timeout": 10,
            "statusMessage": "Checking SCOREBOARD.md is current"
          }
        ]
      }
    ]
  }
}
